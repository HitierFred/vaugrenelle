---
interface Props {
  summary: string;
  open?: boolean;
  name?: string; // groupe exclusif (un seul ouvert)
}

const { summary, open = false, name } = Astro.props;
---

<details class="accordion" open={open} name={name}>
  <summary>
    <span>{summary}</span>
  </summary>
  <div class="accordion__body stack">
    <slot />
  </div>
</details>
