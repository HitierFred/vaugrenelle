---
// Indicateur d'étapes d'un formulaire multi-étapes.
// L'étape courante porte aria-current="step" ; l'état est aussi donné en texte.
interface Props {
  steps: string[];
  current: number; // index à partir de 1
}

const { steps, current } = Astro.props;
const stateOf = (i: number) => (i < current ? 'done' : i === current ? 'current' : 'todo');
const stateLabel = { done: 'terminée', current: 'en cours', todo: 'à venir' } as const;
---

<nav class="stepper" aria-label="Étapes du formulaire">
  <ol>
    {steps.map((step, i) => {
      const state = stateOf(i + 1);
      return (
        <li data-state={state} aria-current={state === 'current' ? 'step' : undefined}>
          <span class="stepper__num" aria-hidden="true">
            {i + 1}
          </span>
          <span>
            {step}
            <span class="visually-hidden stepper__state"> ({stateLabel[state]})</span>
          </span>
        </li>
      );
    })}
  </ol>
</nav>
<p class="stepper__status" data-stepper-status>
  Étape {current} sur {steps.length} : {steps[current - 1]}
</p>
