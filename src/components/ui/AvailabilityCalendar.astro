---
// Calendrier mensuel de disponibilité + alternative en tableau par période.
// Chaque case porte un texte et une icône : la couleur n'est jamais seule.

interface Props {
  year: number;
  month: number; // 1 à 12
  total: number; // quantité en parc
  // Disponibles par jour (AAAA-MM-JJ). Jour absent = tout est disponible.
  availability: Record<string, number>;
  title?: string;
  from?: string; // AAAA-MM-JJ : les jours antérieurs sont affichés comme passés
  legend?: boolean; // une seule légende quand plusieurs mois se suivent
}

const {
  year,
  month,
  total,
  availability,
  title = 'Disponibilités',
  from,
  legend = true,
} = Astro.props;

type DayState = 'libre' | 'partiel' | 'complet' | 'passe';
interface Day {
  iso: string;
  day: number;
  dispo: number;
  state: DayState;
}

const pad = (n: number) => String(n).padStart(2, '0');
const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate();
// Décalage pour une semaine commençant le lundi
const offset = (new Date(Date.UTC(year, month - 1, 1)).getUTCDay() + 6) % 7;

const days: Day[] = Array.from({ length: daysInMonth }, (_, i) => {
  const iso = `${year}-${pad(month)}-${pad(i + 1)}`;
  const dispo = availability[iso] ?? total;
  const state: DayState =
    from && iso < from ? 'passe' : dispo >= total ? 'libre' : dispo > 0 ? 'partiel' : 'complet';
  return { iso, day: i + 1, dispo, state };
});

const cells: (Day | null)[] = [...Array(offset).fill(null), ...days];
while (cells.length % 7) cells.push(null);
// Cases vides consécutives fusionnées (moins d'éléments dans le DOM)
function groupBlanks(week: (Day | null)[]): (Day | { blank: number })[] {
  const out: (Day | { blank: number })[] = [];
  for (const d of week) {
    const last = out.at(-1);
    if (d) out.push(d);
    else if (last && 'blank' in last) last.blank++;
    else out.push({ blank: 1 });
  }
  return out;
}
const weeks = Array.from({ length: cells.length / 7 }, (_, w) => cells.slice(w * 7, w * 7 + 7));

const monthName = new Intl.DateTimeFormat('fr-FR', { month: 'long', timeZone: 'UTC' }).format(
  new Date(Date.UTC(year, month - 1, 1)),
);
const weekdays = [
  ['lun.', 'lundi'],
  ['mar.', 'mardi'],
  ['mer.', 'mercredi'],
  ['jeu.', 'jeudi'],
  ['ven.', 'vendredi'],
  ['sam.', 'samedi'],
  ['dim.', 'dimanche'],
];

const stateText: Record<DayState, string> = {
  libre: 'Libre',
  partiel: 'Partiel',
  complet: 'Complet',
  passe: 'Passé',
};

// Regroupe les jours consécutifs de même disponibilité pour le tableau
const periods: { from: number; to: number; dispo: number; state: DayState }[] = [];
for (const d of days.filter((x) => x.state !== 'passe')) {
  const last = periods.at(-1);
  if (last && last.dispo === d.dispo) last.to = d.day;
  else periods.push({ from: d.day, to: d.day, dispo: d.dispo, state: d.state });
}
const caption = `${title} — ${monthName} ${year}`;
---

<div class="calendar-wrap stack">
  <table class="calendar">
    <caption>{caption}</caption>
    <thead>
      <tr>
        {weekdays.map(([short, long]) => (
          <th scope="col">
            <abbr title={long}>{short}</abbr>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {weeks.map((week) => (
        <tr>
          {groupBlanks(week).map((cell) =>
            'blank' in cell ? (
              <td data-outside colspan={cell.blank > 1 ? cell.blank : undefined} />
            ) : (
              <td data-state={cell.state}>
                <b class="calendar__day">{cell.day}</b>
                {cell.state === 'passe' ? (
                  stateText[cell.state]
                ) : (
                  <>
                    {cell.dispo}/{total}
                    <span class="calendar__label"> {stateText[cell.state]}</span>
                  </>
                )}
              </td>
            ),
          )}
        </tr>
      ))}
    </tbody>
  </table>

  {legend && (
    <ul class="calendar-legend" aria-label="Légende">
      <li>
        <strong>Libre</strong> : tout le parc est disponible
      </li>
      <li>
        <strong>Partiel</strong> : une partie est réservée
      </li>
      <li>
        <strong>Complet</strong> : rien n'est disponible
      </li>
    </ul>
  )}

  <details class="accordion">
    <summary>
      <span>Voir les disponibilités sous forme de tableau</span>
    </summary>
    <div class="accordion__body table-wrap">
      <table class="table">
        <caption>{caption}, par période</caption>
        <thead>
          <tr>
            <th scope="col">Période</th>
            <th scope="col">Disponibles</th>
            <th scope="col">État</th>
          </tr>
        </thead>
        <tbody>
          {periods.map((p) => (
            <tr>
              <th scope="row">
                {p.from === p.to
                  ? `Le ${p.from} ${monthName}`
                  : `Du ${p.from} au ${p.to} ${monthName}`}
              </th>
              <td>
                {p.dispo} sur {total}
              </td>
              <td>{stateText[p.state]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</div>
