---
// Téléversement : les fichiers restent dans le navigateur, rien n'est envoyé
import FieldMessages from './FieldMessages.astro';
import { describedBy } from './field-ids';

interface Props {
  id: string;
  name?: string;
  label: string;
  accept?: string;
  multiple?: boolean;
  hint?: string;
  error?: string;
  required?: boolean;
}

const {
  id,
  name = id,
  label,
  accept,
  multiple = false,
  hint = 'Formats acceptés : PDF, JPG, PNG. Taille maximale : 10 Mo. Le fichier reste sur votre appareil.',
  error,
  required = false,
} = Astro.props;
---

<div class="field">
  <label class="field__label" for={id}>
    {label}
    {required && <span class="field__required">(obligatoire)</span>}
  </label>
  <FieldMessages id={id} hint={hint} error={error} />
  <input
    class="input"
    type="file"
    id={id}
    name={name}
    accept={accept}
    multiple={multiple}
    required={required}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy(id, hint, error)}
  />
</div>
