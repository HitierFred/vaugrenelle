---
import type { HTMLAttributes } from 'astro/types';
import FieldMessages from './FieldMessages.astro';
import { describedBy } from './field-ids';

type Props = {
  id: string;
  name?: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'date' | 'number' | 'search' | 'url';
  hint?: string;
  error?: string;
  required?: boolean;
} & Omit<HTMLAttributes<'input'>, 'id' | 'name' | 'type' | 'required'>;

const { id, name = id, label, type = 'text', hint, error, required = false, ...rest } = Astro.props;
---

<div class="field">
  <label class="field__label" for={id}>
    {label}
    {required && <span class="field__required">(obligatoire)</span>}
  </label>
  <FieldMessages id={id} hint={hint} error={error} />
  <input
    class="input"
    id={id}
    name={name}
    type={type}
    required={required}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={describedBy(id, hint, error)}
    {...rest}
  />
</div>
