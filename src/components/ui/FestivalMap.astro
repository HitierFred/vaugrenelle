---
// Plan schématique des sites du festival (SVG inline).
// La carte est une image : son équivalent textuel est la liste numérotée qui l'accompagne.
interface Site {
  numero: number;
  nom: string;
  x: number;
  y: number;
}
interface Props {
  sites: Site[];
  listId: string; // identifiant de la liste équivalente
}
const { sites, listId } = Astro.props;
---

<figure class="festival-map">
  <svg viewBox="0 0 1000 700" role="img" aria-labelledby="carte-titre carte-desc" focusable="false">
    <title id="carte-titre">Plan schématique des sites du festival Les Échappées</title>
    <desc id="carte-desc">
      {sites.length} sites numérotés dans le centre de Vaugrenelle. La liste qui suit le plan donne
      le nom, l'adresse et l'accessibilité de chaque site.
    </desc>
    <rect width="1000" height="700" fill="#efe9dd"></rect>
    <!-- Parc Brossard -->
    <path d="M60 140 Q120 100 280 130 L320 330 Q200 380 80 330 Z" fill="#cfe3c8"></path>
    <!-- Rivière -->
    <path
      d="M0 600 C200 560 300 520 480 540 S760 620 1000 560 L1000 640 C760 690 600 620 480 610 S200 640 0 680 Z"
      fill="#b9d3e6"
    ></path>
    <!-- Voies principales -->
    <g stroke="#ffffff" stroke-width="22" stroke-linecap="round" fill="none">
      <path d="M40 430 L960 430"></path>
      <path d="M430 60 L430 560"></path>
      <path d="M600 140 L900 470"></path>
      <path d="M200 250 L430 330"></path>
    </g>
    <!-- Voie ferrée -->
    <path d="M720 520 L1000 400" stroke="#5b5f77" stroke-width="6" stroke-dasharray="18 10"></path>
    <!-- Bâtiments repères -->
    <rect x="600" y="180" width="140" height="110" rx="8" fill="#d9d4ca"></rect>
    <rect x="395" y="300" width="70" height="60" rx="6" fill="#d9d4ca"></rect>
    <rect x="330" y="385" width="100" height="50" rx="6" fill="#d9d4ca"></rect>
    {sites.map((s) => (
      <g class="festival-map__marker">
        <circle cx={s.x} cy={s.y} r="30" fill="#b91c1c" stroke="#ffffff" stroke-width="5" />
        <text
          x={s.x}
          y={s.y + 10}
          text-anchor="middle"
          font-size="30"
          font-weight="700"
          fill="#ffffff"
        >
          {s.numero}
        </text>
        <text
          x={s.x > 750 ? s.x : s.x + 42}
          y={s.x > 750 ? s.y - 44 : s.y + 9}
          text-anchor={s.x > 750 ? 'middle' : 'start'}
          font-size="24"
          font-weight="700"
          fill="#1b1f3b"
          paint-order="stroke"
          stroke="#faf7f2"
          stroke-width="6"
        >
          {s.nom}
        </text>
      </g>
    ))}
  </svg>
  <figcaption class="text-small muted">
    Plan schématique, non à l'échelle. <a href={`#${listId}`}>Liste des sites</a>
  </figcaption>
</figure>
