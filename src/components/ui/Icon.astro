---
// Icônes SVG inline, décoratives par défaut (aria-hidden).
// Tracés dessinés pour ce projet, trait de 2 px sur grille 24.
import type { IconName } from './types';

interface Props {
  name: IconName;
  label?: string; // si fourni, l'icône est porteuse de sens
  class?: string;
}

const { name, label, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  check: '<path d="M4 12.5l5 5L20 6.5"/>',
  alert: '<path d="M12 3L2 20h20L12 3z"/><path d="M12 10v4M12 17.5v.5"/>',
  error: '<circle cx="12" cy="12" r="9"/><path d="M8.5 8.5l7 7M15.5 8.5l-7 7"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
  pin: '<path d="M12 21s-7-6.3-7-12a7 7 0 0114 0c0 5.7-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>',
  access: '<circle cx="12" cy="4.5" r="1.5"/><path d="M5 8l7 1.5L19 8M12 9.5V14l-3 7M12 14l3 7"/>',
  'chevron-down': '<path d="M6 9l6 6 6-6"/>',
  'chevron-left': '<path d="M15 6l-6 6 6 6"/>',
  'chevron-right': '<path d="M9 6l6 6-6 6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  ticket:
    '<path d="M3 8V5h18v3a2 2 0 000 4v3H3v-3a2 2 0 000-4z" transform="translate(0 2)"/><path d="M14 7v12" stroke-dasharray="2 2"/>',
  box: '<path d="M3 7l9-4 9 4v10l-9 4-9-4V7z"/><path d="M3 7l9 4 9-4M12 11v10"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>',
  file: '<path d="M6 2h8l5 5v15H6V2z"/><path d="M14 2v5h5"/>',
  minus: '<path d="M5 12h14"/>',
};
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })}
  set:html={paths[name]}
/>
