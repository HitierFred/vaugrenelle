---
// Composition graphique décorative « affiche de spectacle de rue » (SVG, sans image)
interface Props {
  variant?: 'ville' | 'festival';
}
const { variant = 'ville' } = Astro.props;
const accent = variant === 'festival' ? '#b91c1c' : '#c2410c';
---

<svg
  class="poster-art"
  viewBox="0 0 400 300"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid slice"
>
  <rect width="400" height="300" fill="#1b1f3b"></rect>
  <path d="M250 0 L400 0 L400 300 L120 300 Z" fill={accent} opacity="0.92"></path>
  <path d="M250 0 L330 0 L230 300 L150 300 Z" fill="#faf7f2" opacity="0.14"></path>
  <circle cx="110" cy="95" r="54" fill="#faf7f2"></circle>
  <circle cx="110" cy="95" r="30" fill="#1b1f3b"></circle>
  <rect x="40" y="230" width="230" height="10" fill="#faf7f2"></rect>
  <g fill="#faf7f2">
    <rect x="40" y="255" width="18" height="18"></rect>
    <rect x="70" y="255" width="18" height="18"></rect>
    <rect x="100" y="255" width="18" height="18"></rect>
  </g>
  <path d="M300 60 l40 70 h-80 z" fill="#1b1f3b"></path>
  <line
    x1="20"
    y1="190"
    x2="380"
    y2="160"
    stroke="#faf7f2"
    stroke-width="3"
    stroke-dasharray="10 8"
  ></line>
  <circle cx="200" cy="175" r="9" fill="#faf7f2"></circle>
</svg>
