---
import Icon from './Icon.astro';

interface Props {
  id: string;
  hint?: string;
  error?: string;
}

const { id, hint, error } = Astro.props;
---

{hint && (
  <p class="field__hint" id={`${id}-hint`}>
    {hint}
  </p>
)}
{error && (
  <p class="field__error" id={`${id}-error`}>
    <Icon name="error" />
    <span>
      <span class="visually-hidden">Erreur : </span>
      {error}
    </span>
  </p>
)}
