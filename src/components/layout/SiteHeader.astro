---
import Icon from '../ui/Icon.astro';
import Logo from './Logo.astro';
import { isInSection, url } from '../../lib/paths';

const current = Astro.url.pathname;

const items = [
  { label: 'Habiter', href: '/habiter/', section: '/habiter/' },
  { label: 'Sortir & découvrir', href: '/sortir/agenda/', section: '/sortir/' },
  { label: 'Agir & organiser', href: '/agir/', section: '/agir/' },
  { label: 'Régie partagée', href: '/regie/', section: '/regie/' },
];
const account = { label: 'Mon compte (simulé)', href: '/mon-compte/', section: '/mon-compte/' };
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-brand" href={url('/')}>
      <Logo />
      <span class="site-brand__name">
        Vaugrenelle
        <small>la ville comme scène</small>
      </span>
      <span class="visually-hidden"> — Accueil</span>
    </a>

    <vg-nav-toggle>
      <button
        class="btn btn--secondary nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="navigation-principale"
      >
        <Icon name="menu" />
        Menu
      </button>
    </vg-nav-toggle>

    <nav class="site-nav" id="navigation-principale" aria-label="Navigation principale">
      <ul>
        {items.map((item) => (
          <li>
            <a
              href={url(item.href)}
              aria-current={isInSection(current, item.section) ? 'true' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <a
            class="site-nav__account"
            href={url(account.href)}
            aria-current={isInSection(current, account.section) ? 'true' : undefined}
          >
            <Icon name="user" />
            <span>{account.label}</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  // Menu repliable sur petit écran. Sans JavaScript, la navigation reste visible.
  class NavToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      const nav = button && document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (!button || !nav) return;

      const setOpen = (open: boolean) => {
        button.setAttribute('aria-expanded', String(open));
        nav.classList.toggle('is-open', open);
      };

      button.addEventListener('click', () => {
        setOpen(button.getAttribute('aria-expanded') !== 'true');
      });

      nav.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          button.focus();
        }
      });
    }
  }
  customElements.define('vg-nav-toggle', NavToggle);
</script>
