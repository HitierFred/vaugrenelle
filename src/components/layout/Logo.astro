---
// Logotype fictif : une arche de scène bleu ardoise, un « V » et une étoile or.
interface Props {
  size?: number;
  inverse?: boolean; // version claire pour fond sombre
}
const { size = 44, inverse = false } = Astro.props;
const fond = inverse ? '#ffffff' : '#1f3a5f';
const lettre = inverse ? '#1f3a5f' : '#ffffff';
---

<svg width={size} height={size} viewBox="0 0 44 44" aria-hidden="true" focusable="false">
  <path d="M5 42V19C5 9.6 12.6 2 22 2s17 7.6 17 17v23z" fill={fond}></path>
  <path d="M12.5 15h5.2L22 28.4 26.3 15h5.2L24.7 34h-5.4z" fill={lettre}></path>
  <path
    d="M22 6.2l1.1 2.3 2.5.4-1.8 1.8.4 2.5-2.2-1.2-2.2 1.2.4-2.5-1.8-1.8 2.5-.4z"
    fill="#f2c46b"
  ></path>
</svg>
