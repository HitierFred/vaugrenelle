---
// Plan du site généré à partir des contenus : il reste à jour sans saisie.
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { getEvenements, getMateriel } from '../../lib/content';
import { eventUrlPath } from '../../lib/labels';
import { url } from '../../lib/paths';
import { FAMILLES } from '../../lib/regie-data';

const evenements = await getEvenements();
const materiel = await getMateriel();
const lieux = new Map((await getCollection('lieux')).map((l) => [l.id, l.data.nom]));

interface Item {
  label: string;
  href: string;
  children?: Item[];
}

const plan: Item[] = [
  { label: 'Accueil', href: '/' },
  {
    label: 'Sortir & découvrir',
    href: '/sortir/agenda/',
    children: [
      {
        label: 'Agenda culturel',
        href: '/sortir/agenda/',
        children: evenements.map((e) => ({
          label: `${e.data.titre} (${lieux.get(e.data.lieu.id)})`,
          href: eventUrlPath(e.id),
        })),
      },
      { label: 'Festival Les Échappées', href: '/sortir/festival/' },
    ],
  },
  {
    label: 'Agir & organiser',
    href: '/agir/',
    children: [
      { label: 'Toutes les démarches', href: '/agir/' },
      { label: 'Organiser un événement', href: '/agir/organiser-un-evenement/' },
    ],
  },
  {
    label: 'Régie partagée',
    href: '/regie/',
    children: [
      {
        label: 'Catalogue du matériel',
        href: '/regie/catalogue/',
        children: Object.entries(FAMILLES).map(([id, famille]) => ({
          label: famille,
          href: `/regie/catalogue/?famille=${id}`,
          children: materiel
            .filter((m) => m.data.famille === id)
            .map((m) => ({ label: m.data.designation, href: `/regie/catalogue/${m.id}/` })),
        })),
      },
      { label: 'Réserver du matériel', href: '/regie/reserver/' },
    ],
  },
  { label: 'Mon compte (simulé)', href: '/mon-compte/' },
  {
    label: 'Informations',
    href: '/a-propos-du-projet/',
    children: [
      { label: 'À propos du projet', href: '/a-propos-du-projet/' },
      { label: 'Accessibilité', href: '/accessibilite/' },
      { label: 'Écoconception', href: '/ecoconception/' },
      { label: 'Algorithmes publics', href: '/algorithmes-publics/' },
      { label: 'Mentions légales', href: '/mentions-legales/' },
    ],
  },
  {
    label: 'Démonstration',
    href: '/demo/coulisses/',
    children: [
      { label: 'Coulisses de la démonstration', href: '/demo/coulisses/' },
      { label: 'Composants du design system', href: '/demo/composants/' },
      { label: 'Contrôle des données fictives', href: '/demo/donnees/' },
    ],
  },
];
---

<PageLayout
  title="Plan du site"
  lead="Toutes les pages du démonstrateur."
  description="Plan du site du démonstrateur Vaugrenelle : rubriques, événements, matériel et pages d'information."
  breadcrumb={[{ label: 'Plan du site' }]}
>
  <nav aria-label="Plan du site" class="sitemap">
    <ul>
      {plan.map((a) => (
        <li>
          <a href={url(a.href)}>{a.label}</a>
          {a.children && (
            <ul>
              {a.children.map((b) => (
                <li>
                  <a href={url(b.href)}>{b.label}</a>
                  {b.children && (
                    <ul>
                      {b.children.map((c) => (
                        <li>
                          <a href={url(c.href)}>{c.label}</a>
                          {c.children && (
                            <ul>
                              {c.children.map((d) => (
                                <li>
                                  <a href={url(d.href)}>{d.label}</a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</PageLayout>
