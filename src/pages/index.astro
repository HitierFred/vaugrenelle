---
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import cerceaux from '../assets/photos/cerceaux-de-feu.jpg';
import projecteurs from '../assets/photos/projecteurs.jpg';
import repas from '../assets/photos/repas-de-rue.jpg';
import rueCycliste from '../assets/photos/rue-cycliste.jpg';
import terrasse from '../assets/photos/terrasse.jpg';
import villeRiviere from '../assets/photos/ville-riviere.jpg';
import Pictos from '../components/illustrations/Pictos.astro';
import EventCard from '../components/ui/EventCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getActualites, getEvenements } from '../lib/content';
import { formatDate } from '../lib/format';
import { DISCIPLINE_COULEURS, DISCIPLINES, eventUrlPath } from '../lib/labels';
import { url } from '../lib/paths';
import { FESTIVAL, fromReference } from '../lib/reference-date';

const evenements = await getEvenements();
const semaine = evenements.filter((e) => e.data.debut < fromReference(7));
const actualites = (await getActualites()).slice(0, 3);
const festivalEvents = evenements.filter((e) => e.data.festival);
const festivalLieux = new Set(festivalEvents.map((e) => e.data.lieu.id)).size;
const dernierJour = new Date(FESTIVAL.fin.getTime() - 86_400_000);

const lieux = new Map(
  await Promise.all(
    semaine.map(
      async (e) => [e.data.lieu.id, (await getEntry(e.data.lieu))?.data.nom ?? ''] as const,
    ),
  ),
);

const quickLinks = [
  {
    href: '/agir/',
    label: 'Faire une démarche',
    hint: 'Organiser un événement, occuper l’espace public…',
    picto: 'demarche',
  },
  {
    href: '/sortir/agenda/',
    label: 'Agenda et billetterie',
    hint: 'Spectacles, concerts, festival',
    picto: 'billet',
  },
  {
    href: '/regie/reserver/',
    label: 'Réserver du matériel',
    hint: 'Son, lumière, scènes, structures',
    picto: 'projecteur',
  },
] as const;

const rubriques = [
  {
    href: '/habiter/',
    titre: 'Habiter',
    texte: 'Mairie, écoles, solidarités, cadre de vie : la vie quotidienne à Vaugrenelle.',
    photo: rueCycliste,
    alt: 'Une cycliste remonte une rue commerçante bordée de façades anciennes.',
    teinte: 'var(--s-bleu)',
  },
  {
    href: '/sortir/agenda/',
    titre: 'Sortir & découvrir',
    texte: 'Spectacles, concerts, festival : tout l’agenda culturel de la ville.',
    photo: terrasse,
    alt: 'Des habitants dînent en terrasse sur une place, sous des guirlandes lumineuses.',
    teinte: 'var(--s-prune)',
  },
  {
    href: '/agir/',
    titre: 'Agir & organiser',
    texte: 'Un seul dossier pour organiser un événement, et toutes les démarches en ligne.',
    photo: repas,
    alt: 'Un repas de quartier sur de longues tables installées au milieu d’une rue.',
    teinte: 'var(--s-teal)',
  },
  {
    href: '/regie/',
    titre: 'Régie partagée',
    texte: 'Le matériel technique de la Ville, ouvert aux associations et aux compagnies.',
    photo: projecteurs,
    alt: 'Une rampe de projecteurs de scène suspendue dans une salle de spectacle.',
    teinte: 'var(--s-or)',
  },
];
---

<BaseLayout
  title="Accueil"
  description="Portail de la Ville fictive de Vaugrenelle : agenda culturel, festival Les Échappées, démarches en ligne et réservation du matériel municipal."
>
  <div class="container stack" style="--stack-space: var(--sp-16)">
    <section class="home-hero" aria-labelledby="titre-accueil">
      <div class="home-hero__media">
        <Picture
          src={villeRiviere}
          formats={['avif', 'webp']}
          widths={[640, 1000, 1400]}
          sizes="(min-width: 76rem) 76rem, 100vw"
          alt="Les quais de Vaugrenelle : une rivière bordée d’arbres, de maisons anciennes et d’une tour."
          loading="eager"
          fetchpriority="high"
          quality={50}
        />
      </div>
      <div class="home-hero__panel">
        <p class="eyebrow">Bienvenue</p>
        <h1 id="titre-accueil">Vaugrenelle, la ville comme scène</h1>
        <p class="home-hero__lead">
          Sortir, organiser un événement, emprunter du matériel : tous les services de la Ville au
          même endroit.
        </p>
        <p class="cluster">
          <a class="btn btn--primary" href={url('/sortir/agenda/')}>
            Voir l’agenda
          </a>
          <a class="btn btn--secondary" href={url('/agir/')}>
            Faire une démarche
          </a>
        </p>
        <p class="home-hero__festival">
          <strong>Festival Les Échappées</strong>
          <span>
            du {formatDate(FESTIVAL.debut)} au {formatDate(dernierJour)}
          </span>
          <a href={url('/sortir/festival/')}>Voir le programme</a>
        </p>
      </div>
    </section>

    <section aria-labelledby="acces">
      <h2 id="acces" class="visually-hidden">
        Accès rapides
      </h2>
      <ul class="quick-links">
        {quickLinks.map((link) => (
          <li>
            <a href={url(link.href)}>
              <Pictos name={link.picto} />
              <span>
                <span class="quick-links__title">{link.label}</span>
                <span class="quick-links__hint">{link.hint}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="sept-jours">
      <div class="section-head">
        <h2 id="sept-jours">Les 7 prochains jours</h2>
        <a href={url('/sortir/agenda/')}>Tout l’agenda</a>
      </div>
      {semaine.length ? (
        <ul class="grid-cards">
          {semaine.map((e) => (
            <li data-fin={e.data.fin.toISOString()}>
              <EventCard
                titre={e.data.titre}
                href={url(eventUrlPath(e.id))}
                debut={e.data.debut}
                lieu={lieux.get(e.data.lieu.id) ?? ''}
                discipline={DISCIPLINES[e.data.discipline]}
                compagnie={e.data.compagnie}
                gratuit={e.data.gratuit}
                accessibilite={e.data.accessibilite}
                zoneColor={DISCIPLINE_COULEURS[e.data.discipline]}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty-state">Aucun spectacle cette semaine. Consultez l’agenda complet.</p>
      )}
    </section>

    <section aria-labelledby="a-la-une" class="stack" style="--stack-space: var(--sp-8)">
      <h2 id="a-la-une">À la une</h2>
      <article class="feature">
        <div class="feature__art">
          <Picture
            src={cerceaux}
            formats={['avif', 'webp']}
            widths={[480, 800]}
            quality={45}
            sizes="(min-width: 48rem) 50vw, 100vw"
            alt="La nuit, une artiste fait tourner des cerceaux enflammés qui dessinent des spirales de lumière."
            loading="lazy"
          />
        </div>
        <div class="feature__body">
          <p class="feature__kicker">Festival des arts de la rue</p>
          <h3>Les Échappées</h3>
          <p>
            Quatre jours de cirque, de théâtre de rue, de danse et de musique, du{' '}
            {formatDate(FESTIVAL.debut)} au {formatDate(dernierJour)}. {festivalEvents.length}{' '}
            spectacles dans {festivalLieux} lieux, presque tous gratuits.
          </p>
          <a class="btn btn--primary btn--on-dark" href={url('/sortir/festival/')}>
            Découvrir le programme
          </a>
        </div>
      </article>
      <ul class="grid-cards">
        {actualites.map((a) => (
          <li>
            <article class="news">
              <time datetime={a.data.date.toISOString()}>{formatDate(a.data.date)}</time>
              <h3>{a.data.titre}</h3>
              <p>{a.data.resume}</p>
            </article>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="vivre">
      <div class="section-head">
        <h2 id="vivre">Vivre à Vaugrenelle</h2>
      </div>
      <ul class="grid-cards">
        {rubriques.map((r) => (
          <li>
            <article class="photo-card" style={`--c-card-accent: ${r.teinte}`}>
              <Picture
                src={r.photo}
                formats={['avif', 'webp']}
                widths={[360, 560]}
                quality={40}
                sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw"
                alt={r.alt}
                loading="lazy"
              />
              <div class="photo-card__body">
                <h3>
                  <a href={url(r.href)}>{r.titre}</a>
                </h3>
                <p>{r.texte}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  // Masque les événements déjà terminés (la page est générée au build)
  const now = Date.now();
  document.querySelectorAll<HTMLElement>('[data-fin]').forEach((el) => {
    if (Date.parse(el.dataset.fin ?? '') < now) el.hidden = true;
  });
</script>
