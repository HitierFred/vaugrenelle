---
import { getCollection } from 'astro:content';
import chapiteau from '../../../assets/photos/chapiteau.jpg';
import AgendaFilters from '../../../components/islands/AgendaFilters.astro';
import EventRow from '../../../components/ui/EventRow.astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getEvenements } from '../../../lib/content';
import { DISCIPLINE_COULEURS, DISCIPLINES, eventUrlPath } from '../../../lib/labels';
import { url } from '../../../lib/paths';

const evenements = await getEvenements();
const lieux = (await getCollection('lieux')).map((l) => ({ id: l.id, nom: l.data.nom }));
const nomLieu = new Map(lieux.map((l) => [l.id, l.nom]));

// Regroupement par mois, en heure de Paris
const monthKey = new Intl.DateTimeFormat('fr-FR', {
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Paris',
});
const groups = new Map<string, typeof evenements>();
for (const e of evenements) {
  const key = monthKey.format(e.data.debut);
  groups.set(key, [...(groups.get(key) ?? []), e]);
}
---

<PageLayout
  title="Agenda culturel"
  lead="Spectacles, concerts et animations à Vaugrenelle pour les trois prochains mois."
  description="Agenda culturel de Vaugrenelle : cirque, théâtre de rue, musique, danse, marionnettes et spectacles jeune public. Filtres par date, lieu, discipline, gratuité et accessibilité."
  breadcrumb={[{ label: 'Sortir & découvrir' }, { label: 'Agenda' }]}
  photo={chapiteau}
  photoAlt="Un grand chapiteau rayé rouge et blanc, illuminé de guirlandes, la nuit."
  tone="rose"
>
  <AgendaFilters lieux={lieux}>
    {[...groups].map(([month, items], gi) => (
      <section class="agenda-month" data-group aria-labelledby={`mois-${gi}`}>
        <h2 id={`mois-${gi}`}>{month}</h2>
        <ul class="event-list">
          {items.map((e) => (
            <li
              data-event
              data-debut={e.data.debut.toISOString()}
              data-fin={e.data.fin.toISOString()}
              data-lieu={e.data.lieu.id}
              data-discipline={e.data.discipline}
              data-gratuit={String(e.data.gratuit)}
              data-festival={String(e.data.festival)}
              data-acces={e.data.accessibilite.join(' ')}
            >
              <EventRow
                titre={e.data.titre}
                href={url(eventUrlPath(e.id))}
                debut={e.data.debut}
                lieu={nomLieu.get(e.data.lieu.id) ?? ''}
                discipline={DISCIPLINES[e.data.discipline]}
                gratuit={e.data.gratuit}
                accessibilite={e.data.accessibilite}
                zoneColor={DISCIPLINE_COULEURS[e.data.discipline]}
              />
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="empty-state" data-empty hidden>
      Aucun événement ne correspond à vos critères. Essayez d'élargir la période ou d'effacer les
      filtres.
    </p>
  </AgendaFilters>
</PageLayout>
