---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Breadcrumb, { type Crumb } from '../components/layout/Breadcrumb.astro';
import BaseLayout, { type Props as BaseProps } from './BaseLayout.astro';

interface Props extends BaseProps {
  heading?: string; // h1 affiché, par défaut le titre de la page
  lead?: string;
  breadcrumb?: Crumb[];
  // Bandeau vitrine : aplat de couleur et photo (une seule photo par page)
  photo?: ImageMetadata;
  photoAlt?: string;
  tone?: 'orange' | 'jaune' | 'rose' | 'turquoise' | 'violet' | 'vert';
}

const { heading, lead, breadcrumb, photo, photoAlt = '', tone, ...base } = Astro.props;
---

<BaseLayout {...base}>
  <div class="container">
    {breadcrumb && <Breadcrumb items={breadcrumb} />}
    {photo ? (
      <header class="page-hero on-aplat" style={tone ? `--c-zone: var(--c-${tone})` : undefined}>
        <div class="page-hero__text">
          <h1>{heading ?? base.title}</h1>
          {lead && <p class="page-header__lead">{lead}</p>}
          <slot name="header" />
        </div>
        <div class="page-hero__media">
          <Picture
            src={photo}
            formats={['avif', 'webp']}
            widths={[480, 800, 1100]}
            sizes="(min-width: 52rem) 45vw, 100vw"
            alt={photoAlt}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </header>
    ) : tone ? (
      <header class="page-hero page-hero--plain on-aplat" style={`--c-zone: var(--c-${tone})`}>
        <div class="page-hero__text">
          <h1>{heading ?? base.title}</h1>
          {lead && <p class="page-header__lead">{lead}</p>}
          <slot name="header" />
        </div>
      </header>
    ) : (
      <header class="page-header">
        <h1>{heading ?? base.title}</h1>
        {lead && <p class="page-header__lead">{lead}</p>}
        <slot name="header" />
      </header>
    )}
    <slot />
  </div>
</BaseLayout>
